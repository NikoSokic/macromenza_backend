# Kopiraj u .env (nije u gitu) i upiši prave vrijednosti. Na Renderu iste varijable idu u Environment.
# JDBC adresa Supabase poolera (Project Settings > Database > Connection pooling, session mode)
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=<korisnik>
DB_PASSWORD=<lozinka>
GEMINI_API_KEY=<ključ>
